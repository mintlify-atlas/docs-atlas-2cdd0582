  "keyFeatures": [
    "Practice Mode with in-game map guides for all 9 competitive maps",
    "Automatic line-ups (instant smokes and wallbangs)",
    "CS:GO-like jumpthrow and W-jumpthrow binds",
    "Snap-Tap/Null-bind movement input",
    "De-subtick binds for WASD and jump",
    "Pro crosshair and viewmodel options from top 20 teams",
    "Rapid-fire mode for pistols",
    "Better follow-recoil mode"
  ],
  "publicApiSurface": [
    "csafap/MAIN.cfg - Main configuration file",
    "+map_action - Map selection and practice mode radio wheel",
    "+CT_action - CT-side auto line-ups radio wheel",
    "+T_action - T-side auto line-ups radio wheel",
    "+crosshair_action - Crosshair, rapid fire, and movement configs",
    "+JumpThrow - Jumpthrow bind",
    "+WJumpThrow - W-jumpthrow bind",
    "desubJ - Desubtick jumping bind",
    "toggle_rapid - Toggle rapid fire and follow recoil",
    "resetsens - Sensitivity reset alias",
    "reset_crosshair - Crosshair reset alias",
    "reset_viewmodel - Viewmodel reset alias"
  ]
}
